local Functions = {}

function Functions.ChangeLightStyle(Light)
	if not MainStuff.Models.LightReplaceModel
		or #MainStuff.Models.LightReplaceModel == 0 then
		return
	end

	--//==================================================--
	--// LIGHT STAND / LIGHT FIXTURE
	--//==================================================--

	if Light.Name == "LightStand"
		or Light.Name == "Light_Fixture" then

		local LightModelNew =
			MainStuff.Models.LightReplaceModel[1]:Clone()

		local LightModelFixture =
			LightModelNew:FindFirstChild("LightFixture")

		if not LightModelFixture then
			LightModelNew:Destroy()
			return
		end

		local LightModelNeon =
			LightModelFixture:FindFirstChild("Neon")

		local Dust =
			LightModelFixture:FindFirstChild("Dust")

		local Pivot =
			LightModelNew:FindFirstChild("Pivot")

		local LightFixture =
			Light:FindFirstChild("LightFixture")

		if not LightFixture then
			LightModelNew:Destroy()
			return
		end

		local Neon =
			LightFixture:FindFirstChild("Neon")

		local CenterAttach =
			LightModelFixture:FindFirstChild("CenterAttach")

		local SpotLight =
			CenterAttach
			and CenterAttach:FindFirstChild("SpotLight")

		LightModelNew:PivotTo(Light:GetPivot())

		if Pivot then
			Pivot.Parent = Light
		end

		if Dust and LightFixture then
			Dust.Parent = LightFixture
			Dust.CanCollide = false

			local dustNeon =
				Dust:FindFirstChild("Neon")

			if dustNeon then
				dustNeon.Part1 = Neon
			end
		end

		if LightModelNeon and Neon then
			for _, Thing in pairs(
				LightModelNeon:GetChildren()
			) do
				Thing.Parent = Neon
			end
		end

		if SpotLight then
			for _, Particle in pairs(
				LightFixture:GetDescendants()
			) do
				if Particle:IsA("ParticleEmitter")
					or Particle:IsA("Beam") then
					Particle.Enabled =
						SpotLight.Enabled
				end
			end

			local SpotLightConnection

			SpotLightConnection =
				SpotLight.Changed:Connect(function()
					local Brightness =
						SpotLight.Brightness > 0

					for _, Object in pairs(
						LightFixture:GetDescendants()
					) do
						if Object:IsA("ParticleEmitter")
							or Object:IsA("Beam") then

							if SpotLight.Enabled then
								Object.Enabled = Brightness
							else
								Object.Enabled = false
							end
						end
					end
				end)

			Light.Destroying:Once(function()
				if SpotLightConnection then
					SpotLightConnection:Disconnect()
				end
			end)
		end

		LightModelNew:Destroy()

	--//==================================================--
	--// CHANDELIER
	--//==================================================--

	elseif Light.Name == "Chandelier" then

		local LightModelNew =
			MainStuff.Models.LightReplaceModel[1]:Clone()

		local LightModelFixture =
			LightModelNew:FindFirstChild("LightFixture")

		if not LightModelFixture then
			LightModelNew:Destroy()
			return
		end

		local LightModelNeon =
			LightModelFixture:FindFirstChild("Neon")

		local Dust =
			LightModelFixture:FindFirstChild("Dust")

		local Bright =
			LightModelNeon
			and LightModelNeon:FindFirstChild("Bright sh idfk")

		local LightModelGlow =
			LightModelNeon
			and LightModelNeon:FindFirstChild("Glow")

		local LightModelAttachment =
			LightModelNeon
			and LightModelNeon:FindFirstChild("atachm")

		local LightFixture =
			Light:FindFirstChild("LightFixture")

		if not LightFixture then
			LightModelNew:Destroy()
			return
		end

		local Neon =
			LightFixture:FindFirstChild("Neon")

		local Stand =
			Light:FindFirstChild("Stand")

		local SpotLight =
			LightFixture:FindFirstChild("SpotLight")

		LightModelNew:PivotTo(Light:GetPivot())

		if Bright
			and LightModelGlow
			and LightModelAttachment then

			local LightCFrame =
				CFrame.new(
					-0.062,
					1.065,
					0.092,
					1, 0, 0,
					0, 1, 0,
					0, 0, 1
				)

			Bright.CFrame = LightCFrame
			LightModelGlow.CFrame = LightCFrame
			LightModelAttachment.CFrame = LightCFrame

			Bright.Parent = Neon

			local kingAttach =
				LightModelNeon:FindFirstChild(
					"King attachment the second"
				)

			if kingAttach then
				kingAttach.Parent = Neon
			end

			LightModelGlow.Parent = Neon
			LightModelAttachment.Parent = Neon
		end

		if Dust and LightFixture then
			local dustNeon =
				Dust:FindFirstChild("Neon")

			if dustNeon then
				dustNeon.Part1 = Neon
			end

			Dust.CanCollide = false
			Dust.Parent = LightFixture
		end

		if SpotLight then
			for _, Particle in pairs(
				LightFixture:GetDescendants()
			) do
				if Particle:IsA("ParticleEmitter")
					or Particle:IsA("Beam") then
					Particle.Enabled =
						SpotLight.Enabled
				end
			end

			local SpotLightConnection

			SpotLightConnection =
				SpotLight.Changed:Connect(function()
					local Brightness =
						SpotLight.Brightness > 0

					for _, Object in pairs(
						LightFixture:GetDescendants()
					) do
						if Object:IsA("ParticleEmitter")
							or Object:IsA("Beam") then

							if SpotLight.Enabled then
								Object.Enabled = Brightness
							else
								Object.Enabled = false
