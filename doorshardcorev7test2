			math.min(
				stamina
					+ (STAMINA_MAX / 10) * 0.02,
				STAMINA_MAX
			)

		updateBar(true)

		task.wait(0.02)
	end

	cooldown = false
end

--//==================================================--
--// START SPRINT
--//==================================================--

local function startSprint()
	if cooldown
		or isSprinting
		or not Hum
		or not Hum.Parent then
		return
	end

	local MainGame =
		ModuleScripts.MainGame

	if MainGame and MainGame.crouching then
		return
	end

	if stamina <= 0 then
		return
	end

	isSprinting = true

	Hum:SetAttribute(
		"SpeedBoost",
		4
	)

	setSpeed(SPRINT_SPEED)

	TweenService:Create(
		Effect,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			ImageTransparency = 0.15
		}
	):Play()

	local lastTime = os.clock()

	while isSprinting
		and stamina > 0
		and Hum
		and Hum.Parent do

		local keyboardHeld =
			UIS:IsKeyDown(
				Enum.KeyCode.Q
			)

		local sprintInputHeld =
			keyboardHeld
			or mobileSprintHeld

		if not sprintInputHeld
			or (
				MainGame
				and MainGame.crouching
			) then
			break
		end

		local currentTime =
			os.clock()

		local delta =
			currentTime - lastTime

		lastTime = currentTime

		stamina =
			math.max(
				stamina
					- (STAMINA_MAX / SPRINT_TIME)
					* delta,
				0
			)

		updateBar(true)

		if stamina <= 0 then
			break
		end

		RunService.RenderStepped:Wait()
	end

	if isSprinting then
		stopSprint()
	end

	if stamina <= 0 then
		exhausted()
	else
		task.spawn(refillStamina)
	end
end

