--//==================================================--
--// REFILL
--//==================================================--

local function refillStamina()
	if cooldown or refillRunning then
		return
	end

	refillRunning = true

	while stamina < STAMINA_MAX
		and not isSprinting
		and not cooldown do

		stamina =
			math.min(
				stamina
					+ (STAMINA_MAX / 10) * 0.02,
				STAMINA_MAX
			)

		updateBar(true)

		task.wait(0.02)
	end

	refillRunning = false
end

--//==================================================--
--// EXHAUSTION
--//==================================================--

local function exhausted()
	if cooldown then
		return
	end

	cooldown = true
	isSprinting = false
	mobileSprintHeld = false

	stamina = 0
	updateBar(true)

	if Hum and Hum.Parent then
		Hum:SetAttribute(
			"SpeedBoost",
			0
		)

		setSpeed(NORMAL_SPEED)
