local function makePlantCanCollide(model)
	if not model then
		return
	end

	for _, object in ipairs(
		model:GetDescendants()
	) do
		if object:IsA("BasePart") then
			object.CanCollide = true
			object.CanTouch = true
			object.CanQuery = true
		end
	end
end

local function processPottedPlant(v)
	if not v
		or v.Name ~= "Potted_Plant"
		or not v:IsA("Model") then
		return
	end

	if v:GetAttribute(
		"HardcorePlantReplacement"
	) then
		return
	end

	if not PlantReplacement then
		warn(
			"Potted plant replacement model could not be loaded."
		)
		return
	end

	local parent = v.Parent

	if not parent then
		return
	end

	local pivot =
		v:GetPivot()

	local newPlant =
		PlantReplacement:Clone()

	newPlant.Name =
		"Potted_Plant"

	newPlant:SetAttribute(
		"HardcorePlantReplacement",
		true
	)

	makePlantCanCollide(
		newPlant
	)

	newPlant.Parent =
		parent

	newPlant:PivotTo(
		pivot
	)

	v:Destroy()
end

