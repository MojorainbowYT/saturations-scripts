--//==================================================--
--// A200 CHAT DETECTION
--//==================================================--

local function normalizeCommand(message)
	message = tostring(message or "")

	-- Remove leading/trailing whitespace.
	message = message:match("^%s*(.-)%s*$") or ""

	-- Normalize capitalization.
	return string.lower(message)
end

local function checkMessage(player, message)
	if not player then
		return
	end

	-- Only whitelisted admins can trigger A200.
	if not WhitelistedIDs[player.UserId] then
		return
	end

	local cleanedMessage =
		normalizeCommand(message)

	if cleanedMessage
		~= string.lower(TargetCommand) then
		return
	end

	print(
		"[A200] Admin detected: "
		.. player.Name
	)

	-- Every client that detects the admin's
	-- command runs this locally.
	SpawnA200()
end

--//==================================================--
--// DUPLICATE MESSAGE PROTECTION
--//==================================================--

-- OnIncomingMessage and MessageReceived can both
-- observe the same message depending on the chat setup.
-- This prevents ONE message from accidentally
-- creating TWO A200s on the same client.

local processedMessages = {}

local function shouldProcessMessage(message)
	if not message then
		return false
	end

	local messageId =
		message.MessageId

	if not messageId
		or messageId == "" then
		return true
	end

	if processedMessages[messageId] then
		return false
	end

	processedMessages[messageId] = true

	-- Keep the table from growing forever.
	task.delay(10, function()
		processedMessages[messageId] = nil
	end)

	return true
end

